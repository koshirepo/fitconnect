# Documentation: Workspace-wide ignores.
# - Covers artifacts produced anywhere in the monorepo; each app keeps its own
#   .gitignore for tooling specific to it (Wrangler state, PWA dev output).

node_modules/
dist/
dist-ssr/
coverage/
*.local
*.log
npm-debug.log*
.DS_Store
.idea/

# Local secrets — never commit
.env
.env.local
.env.*.local
.dev.vars

# Cloudflare
.wrangler/
worker-configuration.d.ts

# Turbo / build caches, if adopted later
.turbo/

# Local editor/agent tool state
.commandcode/settings.json
.commandcode/taste/

# Wrangler dev logs
wrangler-*.log
wrangler-*.err.log

# Generated Prisma client.
# Rebuilt by scripts/ensure-prisma-client.mjs on postinstall, predev and prebuild,
# so the copy in the tree is derived output rather than source. Committing it put
# 58 machine-written files into every schema diff and buried the real change.
apps/api/src/generated/
