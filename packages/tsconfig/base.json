{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "FitConnect base",
  "_comment": [
    "Settings every app and package in the workspace shares.",
    "Runtime-specific presets (worker.json, react-app.json) extend this and add lib/jsx/types."
  ],
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  }
}
