# Documentation: Local Worker secrets template.
# - Copy to `.dev.vars` (gitignored) for `npm run dev`. Wrangler injects these as
#   environment variables alongside the `[vars]` block in wrangler.toml.
# - The same keys must be set for the deployed environments with
#   `npx wrangler secret put <KEY> --env test` and `--env production`.
# - Never commit real values: `.dev.vars` is ignored precisely so they stay local.

# Signing key for access tokens. Any long random string works locally.
JWT_SECRET="dev-local-jwt-secret-change-me"

# SMTP credentials used for password-reset and report emails.
# Leave blank locally to skip sending; the API logs the failure and continues.
EMAIL_USER=""
EMAIL_PASSWORD=""

# Web Push private key. Must pair with VAPID_PUBLIC_KEY in wrangler.toml.
# Generate a fresh pair with: npx web-push generate-vapid-keys
VAPID_PRIVATE_KEY=""

# Platform default Razorpay account. Gyms that save their own key id and secret
# in Settings collect into their own account; these are the fallback for the
# rest. Test keys start rzp_test_, live keys rzp_live_.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Signing secret for the platform account's webhook endpoint, taken from the
# Razorpay dashboard when the webhook is registered. Without it, webhook
# deliveries for gyms on the platform account are rejected.
RAZORPAY_WEBHOOK_SECRET=""

# Encrypts gym-owned gateway secrets before they are written to D1. Required
# before a gym can save its own keys. Any long random string:
#   openssl rand -base64 32
CREDENTIALS_KEY=""

# Delhivery shipping token from one.delhivery.com → Settings → API Setup.
# Server-side only: it can manifest and cancel real shipments. Leave blank to
# run the shop without a courier — checkout then says shipping is unavailable.
DELHIVERY_API_TOKEN=""

# Shared secret for Delhivery's tracking push. Delhivery signs nothing, so this
# is the whole of the authentication on /webhooks/delhivery/tracking — give the
# same value to Delhivery as the Authorization header they should send. Unset,
# the endpoint refuses every delivery rather than trusting an unsigned one.
DELHIVERY_WEBHOOK_TOKEN=

# Override the host from wrangler.toml. Development defaults to Delhivery
# staging; set this to https://track.delhivery.com only if you must run local
# against production, and remember that bookings then cost real money.
DELHIVERY_BASE_URL=
