// Documentation: Source-of-truth database schema.
// - Defines the D1-backed relational model for users, tenants, memberships, payments, commerce, attendance, audit logging, and push subscriptions.
// - Prisma client generation and SQL migration generation both derive from this file, so schema edits must be followed by a migration diff and client refresh.
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime  = "cloudflare"
}

datasource db {
  provider = "sqlite"
}

// Enum values are stored as plain strings in SQLite.
// PlatformRole: "USER" | "SUPER_ADMIN" | "SUPPORT"
// TenantRole:   "MEMBER" | "COACH" | "ADMIN"
// AccountStatus: "ACTIVE" | "SUSPENDED" | "DELETED"
// PaymentStatus: "PENDING" | "COMPLETED" | "FAILED" | "REFUNDED"
// OrderStatus:   "PENDING" | "CONFIRMED" | "PACKED" | "SHIPPED" | "IN_TRANSIT" | "OUT_FOR_DELIVERY" | "DELIVERED" | "CANCELLED" | "RETURNED"
// ShipmentKind:  "FORWARD" | "REVERSE"
// ShipmentStatus:"PENDING" | "MANIFESTED" | "IN_TRANSIT" | "OUT_FOR_DELIVERY" | "DELIVERED" | "RTO" | "CANCELLED" | "FAILED"
// ReturnStatus:  "REQUESTED" | "APPROVED" | "REJECTED" | "PICKED_UP" | "RECEIVED" | "REFUNDED" | "CANCELLED"
// AuditAction:   "CREATE" | "UPDATE" | "DELETE" | "LOGIN" | "LOGOUT" | "ROLE_CHANGE" | "SETTINGS_CHANGE"
// TodoVisibility: "PRIVATE" | "PROTECTED" | "PUBLIC"

// Platform models

model User {
  id           String   @id @default(cuid())
  name         String
  email        String
  phone        String?
  passwordHash String
  avatarUrl    String?
  /// "MALE", "FEMALE", or "OTHER". Null for accounts created before it was asked for.
  gender       String?
  platformRole String   @default("USER")
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships              TenantMembership[]
  refreshTokens            RefreshToken[]
  passkeys                 WebAuthnCredential[]
  passwordResetTokens      PasswordResetToken[]
  auditLogs                AuditLog[]             @relation("AuditActor")
  orders                   Order[]
  reviews                  ProductReview[]
  comments                 ProductReviewComment[]
  helpful                  ProductReviewHelpful[]
  pushSubscriptions        PushSubscription[]
  recordedPlatformPayments PlatformPayment[]
  tenantLikes              TenantLike[]
  tenantComments           TenantComment[]

  @@index([email])
}

/// One passkey, registered on one device.
///
/// A member signs in with a fingerprint or a face instead of a password. That
/// matters more here than in most apps: a member added at the desk gets their
/// phone number as a password and, when they gave no email, a synthetic address
/// they will never remember. A passkey replaces both with something the phone
/// already holds.
///
/// The private key never leaves the authenticator. What is stored here is the
/// public half, the id the browser hands back, and the signature counter that
/// makes a cloned authenticator detectable.
model WebAuthnCredential {
  id           String @id @default(cuid())
  userId       String
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Base64url, as the browser reports it. Unique across every account.
  credentialId String @unique
  /// The COSE public key, base64url.
  publicKey    String
  /// Signature counter. A value that does not advance is the documented signal
  /// of a cloned authenticator, so it is stored rather than ignored.
  counter      Int    @default(0)
  /// "usb,nfc,ble,internal" — how the browser said it can be reached.
  transports   String?
  /// Whether the key lives on the device itself and can be used without the
  /// account being named first. What makes a one-tap sign-in possible.
  discoverable Boolean @default(false)
  /// Whatever the owner calls it: "Pixel 8", "MacBook". Theirs to recognise.
  label        String?
  createdAt    DateTime @default(now())
  lastUsedAt   DateTime?

  @@index([userId])
}

/// A challenge issued for one WebAuthn ceremony, waiting to be answered.
///
/// The whole point of a challenge is that it is used once, so it is stored
/// server-side and deleted on use rather than handed to the browser to give
/// back. Rows are short-lived by nature and swept on the next issue for the
/// same subject.
model WebAuthnChallenge {
  id        String   @id @default(cuid())
  /// The user, when the ceremony has one. Null for a sign-in that has not named
  /// an account yet — a discoverable-credential login.
  userId    String?
  /// Ties the challenge to one browser across the two calls of a ceremony.
  handle    String   @unique
  challenge String
  /// "REGISTER" | "LOGIN"
  purpose   String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

/// One webhook delivery, and what was decided about it.
///
/// A rejected or ignored delivery used to leave no trace, so "why is this
/// payment still pending" could only be answered from Razorpay's dashboard.
/// Deliberately small: what arrived, what happened, and why.
model WebhookDelivery {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// "payment.captured", "order.paid", "refund.processed", …
  event    String?
  /// Razorpay's own ids, for matching a row against their dashboard.
  gatewayOrderId   String?
  gatewayPaymentId String?
  /// "SETTLED" | "FAILED_ORDER" | "IGNORED" | "BAD_SIGNATURE" | "NO_SECRET"
  /// | "UNKNOWN_ORDER" | "ERROR"
  outcome  String
  /// One line saying why, in the words the desk would use.
  detail   String?
  /// What was returned to Razorpay, so a retry loop is visible as one.
  status   Int    @default(200)
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  /// The lookup behind "what happened to this payment".
  @@index([gatewayOrderId])
}

/// A write the API has already applied, remembered so a replay of the same
/// queued mutation returns the original outcome instead of doing it twice.
/// Rows are short-lived by nature — they only have to outlive a lost response.
model IdempotencyKey {
  key        String   @id
  userId     String
  method     String
  path       String
  statusCode Int
  /// The original response body, replayed verbatim on a repeat.
  response   String
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([token])
}

model RefreshToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([token])
}

// Tenant models

model Tenant {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique /// URL-friendly identifier (e.g. "ironworks-gym")
  email       String?
  phone       String?   @unique
  logoUrl     String?
  address     String?
  estd        DateTime?
  status      String    @default("ACTIVE")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  markdown    String? /// Optional markdown description for the tenant (e.g. about page)
  webhookDeliveries WebhookDelivery[]
  /// The gym's own colour, as a hex string, used for the app's primary accent
  /// on that gym's pages. Null means the platform's default, which is what
  /// every gym looked like before this existed.
  brandColor  String?
  description String? /// Short plain-text tagline shown below the gym name on the public profile

  platformExpiresAt DateTime?

  memberships      TenantMembership[]
  subscriptions    Subscription[]
  shifts           Shift[]
  payments         Payment[]
  workoutPlans     WorkoutPlan[]
  badges           Badge[]
  auditLogs        AuditLog[]
  settings         TenantSettings?
  charges          TenantCharge[]
  platformPayments PlatformPayment[]
  attendances      Attendance[]
  attendanceDevices AttendanceDevice[]
  todos            Todo[]
  rolePermissions  RolePermissionOverride[]
  roles            Role[]
  coupons          Coupon[]
  couponRedemptions CouponRedemption[]
  coinLedger       CoinLedgerEntry[]
  membershipFreezes MembershipFreeze[]
  storeProducts    StoreProduct[]
  storeOrders      StoreOrder[]
  likes            TenantLike[]
  comments         TenantComment[]
  paymentReminders PaymentReminder[]
  bodyMetrics      BodyMetric[]

  @@index([slug])
}

/// A role definition. Built-in roles (MEMBER, COACH, ADMIN, USER, SUPPORT,
/// SUPER_ADMIN) are seeded here so custom roles share one registry; they have
/// `isSystem = true` and cannot be edited or deleted. Custom roles are created
/// by gym admins (`scope = "TENANT"` with a tenantId) or platform staff
/// (`scope = "PLATFORM"` with a null tenantId) and hold their permissions as
/// `RolePermissionOverride` rows with `allowed = true`.
model Role {
  id          String   @id @default(cuid())
  /// "PLATFORM" for platform-scoped roles, "TENANT" for gym-scoped roles.
  scope       String
  /// Stable identifier stored in memberships and override rows, e.g. "FRONT_DESK".
  key         String
  /// Human-readable label shown in the UI.
  name        String
  description String?
  /// Null for platform-wide roles and for the seeded built-ins; set for
  /// custom roles that belong to a single gym.
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// True for the built-in MEMBER/COACH/ADMIN (and platform) roles.
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, scope, key])
  @@index([scope, tenantId])
}

/// Per-role permission overrides layered on top of the static catalog in
/// `src/shared/types/permissions.ts`. A row with `allowed = true` grants a
/// permission the baseline role does not have; `allowed = false` revokes one it
/// does. Rows with a null tenantId are platform-wide defaults. For custom roles
/// the baseline is empty, so every granted permission is an `allowed = true` row.
model RolePermissionOverride {
  id         String   @id @default(cuid())
  /// "PLATFORM" for PlatformRole rows, "TENANT" for TenantRole rows.
  scope      String
  /// PlatformRole or TenantRole value, depending on scope.
  role       String
  permission String
  allowed    Boolean
  /// Null for platform-wide rows; set for overrides scoped to a single gym.
  tenantId   String?
  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  updatedBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([tenantId, scope, role, permission])
  @@index([tenantId])
  @@index([scope, role])
}

model TenantSettings {
  id           String   @id @default(cuid())
  tenantId     String   @unique
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  overdueDays  Int      @default(30) /// Days after subscription expiry to auto-inactivate member
  whatsappTemplates Json @default("{}") /// Tenant-level WhatsApp template overrides keyed by message purpose

  /// Coins the referrer earns when the member they brought in first pays for a
  /// subscription. Zero turns referral rewards off.
  referralRewardCoins  Int @default(0)
  /// Coins the referred member earns at the same moment. Zero for none.
  referralRefereeCoins Int @default(0)
  /// Days a coin lives before the nightly sweep takes it back. 0 — the
  /// default — means coins never expire, which is what every gym had before
  /// this existed.
  coinExpiryDays       Int @default(0)

  /// Razorpay key id for this gym's own account. Null means online payments
  /// fall back to the platform account configured in the Worker environment.
  razorpayKeyId        String?
  /// Key secret, sealed with AES-GCM by `lib/secret-box`. Never leaves the API.
  razorpayKeySecret    String?
  /// Webhook signing secret, sealed the same way.
  razorpayWebhookSecret String?
  /// The webhook this app registered at Razorpay for this gym. Remembered so
  /// a second registration updates that one rather than stacking duplicates
  /// that each deliver the same event.
  razorpayWebhookId    String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model TenantCharge {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String /// e.g. "Admission Fee", "Security Deposit"
  amount      Int /// Rupees, like every other amount in this schema. Converted to paise only at the Razorpay boundary.
  isMandatory Boolean  @default(true) /// Must be paid when adding a new member
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  payments Payment[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

/// Junction table linking users to tenants with a tenant-scoped role.
/// A user can belong to only one gym.
model TenantMembership {
  id                String                  @id @default(cuid())
  tenantId          String
  tenant            Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId            String                  @unique
  user              User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  memberId          Int /// Sequential member number, unique per tenant (starts at 1)
  role              String                  @default("MEMBER")
  status            String                  @default("ACTIVE")
  dueDate           DateTime? /// Latest subscription validUntil - auto-updated on payment changes
  shiftId           String?
  shift             Shift?                  @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  referredByMembershipId String?
  referredBy        TenantMembership?       @relation("MemberReferrals", fields: [referredByMembershipId], references: [id], onDelete: SetNull)
  /// Unguessable key for this member's public ID-card URL. Null until the
  /// card is first issued for a membership that predates the feature.
  idCardToken       String?                 @unique
  /// The number an RFID attendance machine reports for this member. Its
  /// attendance log carries only this, so it is the join between a punch and a
  /// person. Unique per gym, not globally — every gym starts its own at 1.
  deviceUserPin     Int?
  /// What is printed on the card in the member's hand, kept so the desk can
  /// find them by it when the card stops working.
  rfidCardNumber    String?
  joinedAt          DateTime                @default(now())
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  badges            Badge[]
  referrals         TenantMembership[]      @relation("MemberReferrals")
  payments          Payment[]               @relation("PaymentUser")
  collectedPayments Payment[]               @relation("PaymentCollector")
  createdPlans      WorkoutPlan[]           @relation("PlanCreator")
  planAssignments   WorkoutPlanAssignment[] @relation("PlanAssignment")
  attendances       Attendance[]
  markedAttendances Attendance[]            @relation("AttendanceMarkedBy")
  createdTodos      Todo[]                  @relation("TodoCreatedBy")
  updatedTodos      Todo[]                  @relation("TodoUpdatedBy")
  completedTodos    Todo[]                  @relation("TodoCompletedBy")
  couponRedemptions CouponRedemption[]
  coinLedger        CoinLedgerEntry[]
  freezes           MembershipFreeze[]
  storeOrders       StoreOrder[]              @relation("StoreOrderBuyer")
  storeLikes        StoreProductLike[]
  storeComments     StoreProductComment[]
  soldStoreOrders   StoreOrder[]              @relation("StoreOrderSeller")
  paymentReminders  PaymentReminder[]
  sentReminders     PaymentReminder[]         @relation("ReminderActor")
  bodyMetrics       BodyMetric[]
  recordedMetrics   BodyMetric[]              @relation("BodyMetricRecordedBy")

  @@unique([tenantId, userId])
  @@unique([tenantId, memberId])
  @@index([tenantId])
  @@index([userId])
  @@index([shiftId])
  @@index([referredByMembershipId])
  /// The shapes the roster reads actually use, the way Payment already covers
  /// its own. Without these, a status tab scans every membership in the gym and
  /// sorts the survivors in memory; @@unique([tenantId, memberId]) only rescues
  /// the unfiltered list.
  @@index([tenantId, status, memberId])
  @@index([tenantId, status, dueDate])
}

// Subscription and payment

model Subscription {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  amount       Int /// Rupees. Converted to paise only at the Razorpay boundary.
  durationDays Int      @default(30)
  /// Days a term on this plan may be frozen for. 0 means it cannot be frozen,
  /// which is what every plan that predates freezing gets.
  freezeDays   Int      @default(0)
  /// How many separate freezes that budget may be split across.
  freezeCount  Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  payments Payment[]
  badges   Badge[]
  /// Coupons restricted to this plan.
  coupons      Coupon[]

  @@index([tenantId])
}

model Shift {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  startTime   String /// 24-hour local time, e.g. "06:00"
  endTime     String /// 24-hour local time, e.g. "10:00"
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  members     TenantMembership[]

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
}

model Todo {
  id            String            @id @default(cuid())
  tenantId      String
  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  visibility    String            @default("PUBLIC")
  isCompleted   Boolean           @default(false)
  completedAt   DateTime?
  createdById   String?
  createdBy     TenantMembership? @relation("TodoCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById   String?
  updatedBy     TenantMembership? @relation("TodoUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  completedById String?
  completedBy   TenantMembership? @relation("TodoCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([tenantId, updatedAt])
  @@index([tenantId, visibility, isCompleted])
  @@index([createdById])
  @@index([updatedById])
  @@index([completedById])
}

model Payment {
  id             String            @id @default(cuid())
  amount         Int
  status         String            @default("PENDING")
  tenantId       String
  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membershipId   String
  member         TenantMembership  @relation("PaymentUser", fields: [membershipId], references: [id])
  collectorId    String?
  collectedBy    TenantMembership? @relation("PaymentCollector", fields: [collectorId], references: [id])
  subscriptionId String?
  subscription   Subscription?     @relation(fields: [subscriptionId], references: [id])
  chargeId       String?
  charge         TenantCharge?     @relation(fields: [chargeId], references: [id])
  description    String? /// Label for charge payments, e.g. "Admission Fee"
  /// What this cost before any coupon or coins. Null on rows written before
  /// coupons existed, and on rows where nothing was taken off.
  listAmount     Int?
  /// Taken off by a coupon. `amount` is already net of this.
  discountAmount Int     @default(0)
  /// Coins spent against this payment. `amount` is already net of these too.
  coinsRedeemed  Int     @default(0)
  note           String?
  paidAt         DateTime?
  validFrom      DateTime?
  validUntil     DateTime?
  /// Whether settling this buys membership time. False for a balance: the row
  /// it split from already granted the window, and paying the remainder must
  /// not grant another.
  extendsValidity Boolean @default(true)
  /// The payable this row is a share of, for pro-rata validity. Days granted
  /// are durationDays x amount / this. NULL means the whole window, which is
  /// what every row granted before part payments were prorated.
  validityBasisAmount Int?

  /// "RAZORPAY" for online payments; null for cash and other manual entries.
  gateway          String?
  /// Gateway order id. Shared by every row a single checkout paid for.
  gatewayOrderId   String?
  /// Gateway payment id, set once the charge is authorized or captured.
  gatewayPaymentId String?
  /// Whether this gym's own gateway account collected it, or the platform's.
  gatewayAccount   String?

  freezes        MembershipFreeze[]
  /// Set when this row is a gym-store sale rather than a membership payment.
  storeOrder     StoreOrder?

  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([tenantId])
  @@index([membershipId])
  @@index([status])
  @@index([createdAt])
  @@index([gatewayOrderId])
  /// The shapes the hot reads actually use: one gym filtered by status, and
  /// one gym newest-first.
  @@index([tenantId, status])
  @@index([tenantId, createdAt])

  reminders PaymentReminder[]
}

/// One chase for money: a push the cron sent, or a WhatsApp message a member of
/// staff pressed send on. Rows start unlinked and are attached to the payment
/// that eventually arrives, so a settled payment carries the history of what it
/// took to collect it.
model PaymentReminder {
  id           String           @id @default(cuid())
  tenantId     String
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membershipId String
  member       TenantMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  /// PUSH or WHATSAPP. WhatsApp is recorded at the moment staff open the
  /// message; the app cannot know whether it was then sent or read.
  channel      String
  /// Why it went out: RENEWAL_DUE, EXPIRED, PENDING_PAYMENT, or SUSPENDED.
  reason       String
  /// The message as it went out, for the history to show something concrete.
  message      String?
  /// Who pressed send. Null for anything the cron did on its own.
  actorId      String?
  actor        TenantMembership? @relation("ReminderActor", fields: [actorId], references: [id], onDelete: SetNull)
  /// The pending payment this was chasing, when it was chasing one.
  targetPaymentId String?
  /// The payment that arrived afterwards and closed the chase. Null while the
  /// money is still outstanding.
  paymentId    String?
  payment      Payment?         @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  sentAt       DateTime         @default(now())

  @@index([tenantId])
  @@index([paymentId])
  /// The two reads: a member's history, and the unlinked rows a new payment
  /// has to claim.
  @@index([membershipId, paymentId])
  @@index([membershipId, reason, sentAt])
}


/// A coupon grants exactly one kind of benefit, named by `type`: money off,
/// coins to spend later, or extra days of validity. The conditions below
/// narrow who may use it, and are always evaluated server-side — a client
/// only ever sends a code.
model Coupon {
  id          String  @id @default(cuid())
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Stored uppercase; unique per gym rather than globally.
  code        String
  description String?
  /// "DISCOUNT" | "COINS" | "VALIDITY"
  type        String
  /// What the code may be spent on: "SUBSCRIPTION" | "STORE" | "BOTH".
  /// Defaults to subscriptions, which is every coupon that existed before the
  /// gym store did.
  appliesTo   String  @default("SUBSCRIPTION")

  /// DISCOUNT: percentage or flat rupees, with an optional cap on the former.
  percentOff  Int?
  amountOff   Int?
  maxDiscount Int?
  /// COINS: coins granted by a redemption, spendable on a later subscription.
  coinsGranted Int?
  /// VALIDITY: days added on top of the plan's own duration.
  bonusDays   Int?

  /// Only for a member with no completed subscription payment ever.
  firstTimeOnly Boolean @default(false)
  /// "MALE" | "FEMALE" | "OTHER", or null for any.
  gender        String?
  /// Minimum list price before the coupon applies.
  minAmount     Int?
  /// The member must hold one of these. Empty means no badge requirement.
  badges        Badge[]
  /// Plans it applies to. Empty means every plan.
  subscriptions Subscription[]

  maxRedemptions  Int?
  /// Incremented with a conditional update so a race cannot oversell it.
  redemptionCount Int      @default(0)
  maxPerMember    Int      @default(1)
  startsAt        DateTime?
  endsAt          DateTime?
  isActive        Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  redemptions CouponRedemption[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
}

/// One use of a coupon. The benefit is frozen here at redemption time, so
/// editing the coupon later cannot rewrite what a member already received.
model CouponRedemption {
  id             String           @id @default(cuid())
  couponId       String
  coupon         Coupon           @relation(fields: [couponId], references: [id], onDelete: Cascade)
  tenantId       String
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membershipId   String
  membership     TenantMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  paymentId      String?
  discountAmount Int              @default(0)
  coinsGranted   Int              @default(0)
  bonusDays      Int              @default(0)
  /// The staff member who applied it, for the audit trail.
  appliedById    String?
  /// Set when a refund reverses it, which frees the redemption slot.
  reversedAt     DateTime?
  createdAt      DateTime         @default(now())

  @@index([couponId])
  @@index([membershipId])
  @@index([tenantId])
  @@index([couponId, membershipId])
}

/// Coins are money owed, so they are kept as a ledger rather than a balance:
/// one row per earn, spend, or reversal, with the balance as their sum. A
/// single counter could not explain itself or survive a refund.
model CoinLedgerEntry {
  id                 String           @id @default(cuid())
  tenantId           String
  tenant             Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membershipId       String
  membership         TenantMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  /// Positive earns, negative spends.
  amount             Int
  /// "COUPON" | "REDEEMED" | "REVERSAL" | "ADJUSTMENT"
  reason             String
  note               String?
  couponRedemptionId String?
  paymentId          String?
  createdById        String?
  createdAt          DateTime         @default(now())

  @@index([membershipId])
  @@index([tenantId])
  /// The nightly expiry sweep: earns older than N days, per gym.
  @@index([tenantId, createdAt])
}

/// One freeze of one term.
///
/// Attached to the payment whose validity it extends rather than to the
/// membership: that is what makes the budget belong to the term, and what lets
/// a reversal know which `validUntil` to put back.
model MembershipFreeze {
  id            String           @id @default(cuid())
  tenantId      String
  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membershipId  String
  membership    TenantMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  /// The payment this extends. Its plan supplies the budget.
  paymentId     String
  payment       Payment          @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  startsOn      DateTime
  /// What was booked.
  plannedEndsOn DateTime
  /// What was actually used. Null while the freeze is still running.
  endedOn       DateTime?
  /// Days charged against the budget: the booked count until it ends, then the
  /// real one.
  daysUsed      Int
  reason        String?
  /// "ENDED_EARLY" | "ATTENDED", or null when it simply ran its course.
  endedBy       String?
  createdById   String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([membershipId])
  @@index([paymentId])
  @@index([tenantId])
}
model BodyMetric {
  id           String            @id @default(cuid())
  tenantId     String
  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membershipId String
  membership   TenantMembership  @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  /// The calendar day the member was measured, with no time component — the
  /// same shape Attendance uses, so "one reading per day" is a constraint the
  /// database enforces rather than a rule the app hopes to remember.
  measuredOn   DateTime
  /// NULL = the member recorded it themselves, otherwise the staff membership
  /// that took the reading. Mirrors Attendance.markedById.
  recordedById String?
  recordedBy   TenantMembership? @relation("BodyMetricRecordedBy", fields: [recordedById], references: [id])

  /// Every field below is optional on its own. A member who only ever steps on
  /// a scale should not be blocked for owning no tape measure, and a coach
  /// doing a full assessment should not have to invent the numbers they skip.
  ///
  /// Stored as Float, unlike money, which this schema keeps in integer paise.
  /// A rupee is exact and has to sum exactly; a body measurement arrives with
  /// its own error already in it, and nothing here is ever totalled — these
  /// values are charted and subtracted, never accumulated.
  weightKg     Float?
  /// Kept per reading rather than once on the member, so BMI is computable
  /// from a single row, and so an old reading keeps the height it was actually
  /// taken at instead of being recalculated against the member's height today.
  heightCm     Float?
  bodyFatPct   Float?
  muscleMassKg Float?

  /// Circumferences, in centimetres.
  chestCm      Float?
  waistCm      Float?
  hipsCm       Float?
  armCm        Float?
  thighCm      Float?

  notes        String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  /// One reading per member per day. A second reading on the same day edits
  /// the first rather than adding a point, which keeps a progress chart from
  /// growing vertical steps where somebody weighed themselves twice.
  @@unique([membershipId, measuredOn])
  /// The chart's own query: one member's readings, oldest first.
  @@index([membershipId, measuredOn])
  @@index([tenantId, measuredOn])
  @@index([recordedById])
}

// Commerce

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  markdown    String? /// Optional markdown rich description for the product
  photos      Json     @default("[]")
  category    String
  price       Int
  stock       Int      @default(0)
  minOrderQty Int      @default(1)
  maxOrderQty Int      @default(100)
  /// Shipping weight of one unit. Couriers price on this, so a wrong value is a
  /// wrong quote; 500g is the shop's stock assumption for anything unmeasured.
  weightGrams Int      @default(500)
  /// Packed size of one unit, in centimetres. Couriers bill the greater of
  /// actual and volumetric weight (L×W×H ÷ 5000), so a light bulky parcel — a
  /// yoga mat, a foam roller — is priced on the space it takes, not its mass.
  lengthCm    Int      @default(10)
  widthCm     Int      @default(10)
  heightCm    Int      @default(10)
  /// Which warehouse ships this product. Null falls back to the default one,
  /// which is what every product was before there was more than one warehouse.
  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  /// Whether a buyer may send this back at all. False for anything hygiene or
  /// food-safety rules will not take back once opened.
  isReturnable Boolean @default(true)
  /// Whether a faulty or damaged one is swapped rather than refunded. Separate
  /// from returnable: a sealed supplement can be replaceable without ever being
  /// returnable for a change of mind.
  isReplaceable Boolean @default(false)
  /// Days after delivery this product may be returned. NULL follows the shop
  /// setting, so changing that still moves everything that never asked for an
  /// exception.
  returnWindowDays Int?
  /// Shown to the buyer beside the policy. For the case the flags cannot say —
  /// "unopened only", "original packaging".
  returnPolicyNote String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems OrderItem[]
  reviews    ProductReview[]

  @@index([isActive])
  @@index([category])
  @@index([warehouseId])
}

model ProductReview {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId        String? /// NULL for anonymous reviews
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  rating        Int /// 1-5 star rating
  title         String
  description   String
  isAnonymous   Boolean  @default(false)
  verifiedBuyer Boolean  @default(false) /// true if user purchased this product
  helpfulCount  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  comments ProductReviewComment[]
  helpful  ProductReviewHelpful[]

  @@unique([productId, userId, createdAt]) /// Prevent multiple reviews per user per day (can adjust if needed)
  @@index([productId])
  @@index([userId])
  @@index([rating])
  @@index([createdAt])
}

model ProductReviewComment {
  id          String        @id @default(cuid())
  reviewId    String
  review      ProductReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId      String? /// NULL for anonymous comments
  user        User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  text        String
  isAnonymous Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([reviewId])
  @@index([userId])
  @@index([createdAt])
}

model ProductReviewHelpful {
  id        String        @id @default(cuid())
  reviewId  String
  review    ProductReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId    String /// Only logged-in users can mark helpful
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@unique([reviewId, userId])
  @@index([reviewId])
  @@index([userId])
}

model Order {
  id             String   @id @default(cuid())
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  buyerName      String
  buyerEmail     String
  buyerPhone     String
  /// The street line. Kept as the whole address for orders placed before the
  /// shop shipped anything, which is why the parts below are optional.
  buyerAddress   String
  buyerCity      String?
  buyerState     String?
  /// Six digits. A courier can do nothing without it, so every new order has one.
  buyerPincode   String?
  /// Fulfilment: PENDING → CONFIRMED → PACKED → SHIPPED → IN_TRANSIT →
  /// OUT_FOR_DELIVERY → DELIVERED, or CANCELLED / RETURNED. Not about money —
  /// see paymentStatus.
  status         String   @default("PENDING")
  subtotalAmount Int      @default(0)
  gstRatePct     Int      @default(18)
  gstAmount      Int      @default(0)
  /// What the courier costs the buyer. Quoted at checkout and frozen here, so a
  /// later change to Delhivery's rates cannot re-price an order already placed.
  shippingAmount Int      @default(0)
  /// Why carriage came out unpriced, when it did. NULL is the ordinary case.
  /// A quote can legitimately return zero — no courier token, nothing resolving
  /// to a warehouse, a warehouse with no pincode — and the sale still goes
  /// through, by design. This is how the shop finds out it happened instead of
  /// absorbing the freight silently.
  shippingQuoteIssue String?
  totalAmount    Int
  /// Money: PENDING, COMPLETED, FAILED, REFUNDED. An order placed before the
  /// shop took cards stays PENDING here, which is what it always was.
  paymentStatus    String    @default("PENDING")
  /// Razorpay's order id, which is what the browser and the webhook both
  /// return an order by. Indexed for exactly that lookup.
  gatewayOrderId   String?
  gatewayPaymentId String?
  paidAt           DateTime?
  /// Razorpay's refund id and what it sent back, in paise. Partial refunds are
  /// possible, so the amount is recorded rather than inferred from the total.
  gatewayRefundId  String?
  refundAmount     Int?
  refundedAt       DateTime?
  /// Fulfilment timestamps, each set once when the state is first reached.
  confirmedAt    DateTime?
  shippedAt      DateTime?
  deliveredAt    DateTime?
  cancelledAt    DateTime?
  cancelReason   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  items     OrderItem[]
  shipments Shipment[]
  returns   ReturnRequest[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([gatewayOrderId])
}

/// A place parcels leave from, and the pickup location Delhivery has on file.
///
/// `name` is the join between the two systems: Delhivery matches a manifest to
/// a warehouse by that string and refuses anything it does not recognise, which
/// is why it is unique here and why the app registers it through the API rather
/// than trusting somebody to retype it.
model Warehouse {
  id            String  @id @default(cuid())
  name          String  @unique
  contactPerson String?
  phone         String
  email         String?
  address       String
  city          String
  state         String
  pincode       String
  /// Where returns come back to, when that is not the pickup address.
  returnAddress String?
  returnCity    String?
  returnState   String?
  returnPincode String?
  /// The one used for products that name no warehouse of their own. Exactly one
  /// warehouse holds this at a time.
  isDefault     Boolean @default(false)
  isActive      Boolean @default(true)
  /// When Delhivery last accepted this warehouse. Null means it exists here but
  /// not there, and nothing can be manifested from it yet.
  registeredAt  DateTime?
  /// What Delhivery said if it refused the registration, kept for the operator.
  registerError String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  products       Product[]
  shipments      Shipment[]
  pickupRequests PickupRequest[]

  @@index([isActive])
}

/// A collection Delhivery has been asked to make from one warehouse.
///
/// Recorded rather than fired and forgotten: an operator asking twice for the
/// same morning wants to see that the first request exists, and a courier that
/// does not turn up is a conversation about a specific pickup id.
model PickupRequest {
  id          String    @id @default(cuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  /// Delhivery's own id for the collection.
  pickupId    String?
  pickupDate  String
  pickupTime  String
  expectedPackageCount Int
  /// REQUESTED, or FAILED with the courier's reason in `note`.
  status      String    @default("REQUESTED")
  note        String?
  requestedById String?
  createdAt   DateTime  @default(now())

  @@index([warehouseId])
  @@index([pickupDate])
}

/// One courier consignment for an order — the parcel going out, or a return
/// coming back. Kept apart from Order because an order can produce several: a
/// forward shipment per warehouse the order draws on, then a reverse one when
/// the buyer sends something back.
model Shipment {
  id       String @id @default(cuid())
  orderId  String
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// The warehouse this parcel left from, or comes back to. Null on parcels
  /// booked before warehouses were records rather than a setting.
  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  /// Only "DELHIVERY" today. Named so a second courier does not need a migration.
  provider String @default("DELHIVERY")
  /// FORWARD (to the buyer) or REVERSE (back to the warehouse).
  kind     String @default("FORWARD")
  /// Delhivery's waybill — the number the buyer tracks and the courier scans.
  waybill  String
  /// PENDING, MANIFESTED, IN_TRANSIT, OUT_FOR_DELIVERY, DELIVERED, RTO,
  /// CANCELLED, FAILED. Mapped from Delhivery's own status vocabulary.
  status       String    @default("PENDING")
  /// Delhivery's wording for the latest scan, shown to the buyer as-is.
  statusDetail String?
  /// Where the parcel was last seen, from the newest scan.
  currentLocation String?
  /// The warehouse this went out from, as registered with Delhivery.
  pickupLocation  String?
  estimatedDeliveryAt DateTime?
  /// The scan history from the last sync. Stored so the tracking page can be
  /// drawn without calling Delhivery on every page view.
  scans        Json      @default("[]")
  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  returnRequests ReturnRequest[]

  @@unique([provider, waybill])
  @@index([orderId])
  @@index([status])
  @@index([warehouseId])
}

/// A buyer asking for an order back, and everything that follows from it.
/// Approval is a human decision; the refund that follows is not.
model ReturnRequest {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// REQUESTED → APPROVED → PICKED_UP → RECEIVED → REFUNDED, or REJECTED /
  /// CANCELLED. Rejected and cancelled requests are kept as a record.
  status  String @default("REQUESTED")
  reason  String
  /// What the buyer typed beyond the canned reason.
  comment String?
  /// The reverse consignment, once approval has booked one.
  shipmentId String?
  shipment   Shipment? @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  /// Who approved or rejected it, and when. A user id, not a membership: this
  /// is platform staff acting on a platform order.
  decidedById String?
  decidedAt   DateTime?
  decisionNote String?
  refundAmount Int?
  refundedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([orderId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  productName String
  quantity    Int
  unitPrice   Int
  lineTotal   Int
  createdAt   DateTime @default(now())

  @@unique([orderId, productId])
  @@index([orderId])
  @@index([productId])
}

// Workout plans

model WorkoutPlan {
  id          String           @id @default(cuid())
  tenantId    String
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creatorId   String
  creator     TenantMembership @relation("PlanCreator", fields: [creatorId], references: [id])
  title       String
  description String?
  exercises   Json             @default("[]")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  assignments WorkoutPlanAssignment[]

  @@index([tenantId])
  @@index([creatorId])
}

model WorkoutPlanAssignment {
  id           String           @id @default(cuid())
  planId       String
  plan         WorkoutPlan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  membershipId String
  membership   TenantMembership @relation("PlanAssignment", fields: [membershipId], references: [id])
  assignedAt   DateTime         @default(now())

  @@unique([planId, membershipId])
  @@index([membershipId])
}

// Badges

model Badge {
  id          String             @id @default(cuid())
  tenantId    String
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  color       String             @default("#6366f1") /// Hex color for badge display
  icon        String? /// Optional icon identifier (e.g. "trophy", "star", "flame")
  /// Whether handing this badge out needs more than the ordinary assign right.
  /// For badges that carry weight — staff credentials, lifetime standing —
  /// anything a coach should not be able to grant on the floor.
  /// Enforced against `badges:assign:restricted`, which only ADMIN holds by
  /// default and which a gym can grant to a custom role through role overrides.
  restricted  Boolean            @default(false)
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  users       TenantMembership[]
  subscriptions Subscription[]
  /// Coupons that require this badge.
  coupons     Coupon[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

// Platform billing

model PlatformPayment {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  amount         Int /// Amount in smallest currency unit (paise/cents)
  note           String?
  extendsUntil   DateTime /// The new expiry date set by this payment
  recordedBy     String
  recordedByUser User     @relation(fields: [recordedBy], references: [id])
  createdAt      DateTime @default(now())

  @@index([tenantId])
}

// Attendance and audit log

/// An RFID attendance machine on a gym's wall. A gym may have several.
model AttendanceDevice {
  id           String    @id @default(cuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Globally unique: it is the only thing an incoming punch carries that says
  /// which gym it belongs to. These devices send no secret and no signature.
  serialNumber String    @unique
  name         String
  location     String?
  /// The zone the device's own clock is set to. Its punches carry a local time
  /// with no offset, so without this they cannot be placed on a calendar.
  timezone     String    @default("Asia/Kolkata")
  isActive     Boolean   @default(true)
  /// Any contact, including an idle command poll — this is what says "online".
  lastSeenAt   DateTime?
  /// The last real punch, which is what says the door is being used.
  lastPunchAt  DateTime?
  /// The device's own upload cursor, echoed back so it stops resending history.
  stamp        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  commands     DeviceCommand[]

  @@index([tenantId])
}

/// A line waiting to be handed to a device the next time it polls.
///
/// These machines cannot be pushed to, so an enrolment has to wait somewhere
/// until the device asks for work. One row per device per change: each is told
/// separately and each can fail separately.
model DeviceCommand {
  id           String           @id @default(cuid())
  deviceId     String
  device       AttendanceDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  tenantId     String
  /// Handed to the device verbatim, minus the id prefix the protocol adds.
  command      String
  /// USER_SET or USER_DELETE, so the queue reads as something.
  kind         String
  /// Null once the member is gone; the command outlives them.
  membershipId String?
  /// Handed over. Not the same as applied — the device confirms separately.
  sentAt       DateTime?
  completedAt  DateTime?
  /// The device's own return code. 0 is success.
  resultCode   String?
  createdAt    DateTime         @default(now())

  @@index([deviceId, sentAt])
  @@index([tenantId])
  @@index([membershipId])
}

model Attendance {
  id           String            @id @default(cuid())
  tenantId     String
  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membershipId String
  member       TenantMembership  @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  markedById   String? /// NULL = self check-in, otherwise the admin/coach who marked
  markedBy     TenantMembership? @relation("AttendanceMarkedBy", fields: [markedById], references: [id])
  date         DateTime /// The calendar day (no time component)
  checkInAt    DateTime          @default(now())
  note         String?
  createdAt    DateTime          @default(now())

  @@unique([tenantId, membershipId, date])
  @@index([tenantId])
  @@index([membershipId])
  @@index([date])
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String /// e.g. "User", "Tenant", "Payment"
  entityId  String?
  actorId   String?
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  metadata  Json? /// Additional context (old values, new values, etc.)
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([actorId])
  @@index([entity, entityId])
  @@index([createdAt])
}

// Push subscriptions

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}


// ─── Gym store ────────────────────────────────────────────────────────────────
// A gym's own stock, distinct from the platform storefront above. The models are
// separate rather than a `tenantId` bolted onto `Product`/`Order` for three
// reasons: those carry shipping details a counter sale has no use for, a
// nullable tenant id makes every existing query correct only by remembering a
// filter, and variants would change the platform storefront for no benefit.

/// Something a gym sells. The sellable unit is the variant, not this — a
/// supplement is bought as a flavour and a size, never as "the supplement".
model StoreProduct {
  id          String  @id @default(cuid())
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  /// One plain line, shown on the storefront card.
  description String?
  /// The long form, rendered as markdown on the product page. Where a gym
  /// writes ingredients, dosage, or what the kit is actually made of.
  markdown    String?
  /// "SUPPLEMENT" | "ACCESSORY"
  category    String
  photos      Json    @default("[]")
  /// A single video, usually YouTube. Stored as the URL a gym pasted; the
  /// player turns it into an embed, so a share link and a watch link both work.
  videoUrl    String?
  /// Coins the buyer earns when an order containing this completes. Per product
  /// because a ₹3,000 protein tub and a ₹200 pair of gloves should not reward
  /// the same. Zero turns the gift off.
  coinsGranted Int    @default(0)
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variants StoreVariant[]
  likes    StoreProductLike[]
  comments StoreProductComment[]

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([tenantId, category])
}

/// Approval of a gym itself, from its public profile.
///
/// Keyed by user rather than membership, unlike the product tables: the people
/// who react to a gym's page include prospects deciding whether to join, and a
/// membership id would shut exactly those people out.
model TenantLike {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
}

/// What somebody said about a gym on its public page.
model TenantComment {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, createdAt])
  @@index([userId])
}

/// A member's approval of a product. One per member per product — the unique
/// key is what makes the button a toggle rather than a counter anyone can run up.
model StoreProductLike {
  id           String           @id @default(cuid())
  productId    String
  product      StoreProduct     @relation(fields: [productId], references: [id], onDelete: Cascade)
  membershipId String
  membership   TenantMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  createdAt    DateTime         @default(now())

  @@unique([productId, membershipId])
  @@index([productId])
  @@index([membershipId])
}

/// What a member said about a product. Plain text on purpose: this is a gym's
/// shop, not a forum, and anything richer would need moderation nobody staffs.
model StoreProductComment {
  id           String           @id @default(cuid())
  productId    String
  product      StoreProduct     @relation(fields: [productId], references: [id], onDelete: Cascade)
  membershipId String
  membership   TenantMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  body         String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([productId, createdAt])
  @@index([membershipId])
}

/// One buyable combination: chocolate 1kg, or black large. Price and stock live
/// here because the combinations sell independently of each other.
model StoreVariant {
  id        String       @id @default(cuid())
  productId String
  product   StoreProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// What the counter says out loud, e.g. "Chocolate · 1kg".
  name      String
  /// The axes that make this variant, e.g. `{"flavour":"Chocolate","size":"1kg"}`
  /// or `{"size":"L","colour":"Black"}`. Free-form because supplements and
  /// accessories do not share axes, and a gym may invent its own.
  attributes Json    @default("{}")
  sku       String?
  price     Int
  stock     Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems StoreOrderItem[]

  @@index([productId])
  @@index([productId, isActive])
}

/// A purchase from a gym's store, whether taken online or over the counter.
model StoreOrder {
  id           String           @id @default(cuid())
  tenantId     String
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Who bought it, when the buyer is a member. Null for a guest: somebody who
  /// bought from the public storefront without joining the gym.
  membershipId String?
  member       TenantMembership? @relation("StoreOrderBuyer", fields: [membershipId], references: [id])
  /// Who to call when a guest order is ready for collection. Set only when the
  /// membership is null — a member is already reachable through their own
  /// record. No address, because this store is collection-only.
  buyerName    String?
  buyerPhone   String?
  buyerEmail   String?
  /// Staff who rang it up, for a counter sale. Null for an online purchase.
  soldById     String?
  soldBy       TenantMembership? @relation("StoreOrderSeller", fields: [soldById], references: [id])

  /// "PENDING" | "COMPLETED" | "CANCELLED"
  status  String @default("PENDING")
  /// "ONLINE" | "COUNTER"
  channel String

  /// Line totals before anything came off.
  subtotalAmount Int
  /// Taken off by a coupon.
  discountAmount Int @default(0)
  /// Coins spent against this order. `totalAmount` is already net of both.
  coinsRedeemed  Int @default(0)
  totalAmount    Int
  /// Coins earned, frozen at completion so editing a product later cannot
  /// rewrite what a member was given.
  coinsEarned    Int @default(0)

  /// The money row this sale wrote, so store revenue reaches the finance page
  /// through the same ledger as memberships and charges.
  paymentId String?  @unique
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  /// A guest sale writes no Payment row — relaxing Payment.membershipId would
  /// mean rebuilding a table four others point at — so the gateway trail lives
  /// here instead. Null on a member order, whose trail is on its payment.
  gateway          String?
  gatewayOrderId   String?
  gatewayPaymentId String?

  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items StoreOrderItem[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([membershipId])
  @@index([tenantId, createdAt])
  /// The desk looks a guest order up by the phone number the buyer gave.
  @@index([tenantId, buyerPhone])
  /// How a settlement finds the order it belongs to.
  @@index([gatewayOrderId])
}

/// One line of a store order. The product and variant names and attributes are
/// copied here rather than read through the relation, so renaming a flavour or
/// retiring a variant can never rewrite a receipt someone already holds.
model StoreOrderItem {
  id         String       @id @default(cuid())
  orderId    String
  order      StoreOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId  String
  variant    StoreVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  productName String
  variantName String
  attributes  Json @default("{}")

  quantity  Int
  unitPrice Int
  lineTotal Int

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([variantId])
}

