// Documentation: Source-of-truth database schema.
// - Defines the D1-backed relational model for users, tenants, memberships, payments, commerce, attendance, audit logging, and push subscriptions.
// - Prisma client generation and SQL migration generation both derive from this file, so schema edits must be followed by a migration diff and client refresh.
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime  = "cloudflare"
}

datasource db {
  provider = "sqlite"
}

// Enum values are stored as plain strings in SQLite.
// PlatformRole: "USER" | "SUPER_ADMIN" | "SUPPORT"
// TenantRole:   "MEMBER" | "COACH" | "ADMIN"
// AccountStatus: "ACTIVE" | "SUSPENDED" | "DELETED"
// PaymentStatus: "PENDING" | "COMPLETED" | "FAILED" | "REFUNDED"
// OrderStatus:   "PENDING" | "SHIPPED" | "DELIVERED"
// AuditAction:   "CREATE" | "UPDATE" | "DELETE" | "LOGIN" | "LOGOUT" | "ROLE_CHANGE" | "SETTINGS_CHANGE"
// TodoVisibility: "PRIVATE" | "PROTECTED" | "PUBLIC"

// Platform models

model User {
  id           String   @id @default(cuid())
  name         String
  email        String
  phone        String?
  passwordHash String
  avatarUrl    String?
  platformRole String   @default("USER")
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships              TenantMembership[]
  refreshTokens            RefreshToken[]
  passwordResetTokens      PasswordResetToken[]
  auditLogs                AuditLog[]             @relation("AuditActor")
  orders                   Order[]
  reviews                  ProductReview[]
  comments                 ProductReviewComment[]
  helpful                  ProductReviewHelpful[]
  pushSubscriptions        PushSubscription[]
  recordedPlatformPayments PlatformPayment[]

  @@index([email])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([token])
}

model RefreshToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([token])
}

// Tenant models

model Tenant {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique /// URL-friendly identifier (e.g. "ironworks-gym")
  email       String?
  phone       String?   @unique
  logoUrl     String?
  address     String?
  estd        DateTime?
  status      String    @default("ACTIVE")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  markdown    String? /// Optional markdown description for the tenant (e.g. about page)
  description String? /// Short plain-text tagline shown below the gym name on the public profile

  platformExpiresAt DateTime?

  memberships      TenantMembership[]
  subscriptions    Subscription[]
  shifts           Shift[]
  payments         Payment[]
  workoutPlans     WorkoutPlan[]
  badges           Badge[]
  auditLogs        AuditLog[]
  settings         TenantSettings?
  charges          TenantCharge[]
  platformPayments PlatformPayment[]
  attendances      Attendance[]
  todos            Todo[]
  rolePermissions  RolePermissionOverride[]

  @@index([slug])
}

/// Per-role permission overrides layered on top of the static catalog in
/// `src/shared/types/permissions.ts`. A row with `allowed = true` grants a
/// permission the baseline role does not have; `allowed = false` revokes one it
/// does. Rows with a null tenantId are platform-wide defaults.
model RolePermissionOverride {
  id         String   @id @default(cuid())
  /// "PLATFORM" for PlatformRole rows, "TENANT" for TenantRole rows.
  scope      String
  /// PlatformRole or TenantRole value, depending on scope.
  role       String
  permission String
  allowed    Boolean
  /// Null for platform-wide rows; set for overrides scoped to a single gym.
  tenantId   String?
  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  updatedBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([tenantId, scope, role, permission])
  @@index([tenantId])
  @@index([scope, role])
}

model TenantSettings {
  id           String   @id @default(cuid())
  tenantId     String   @unique
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  overdueDays  Int      @default(30) /// Days after subscription expiry to auto-inactivate member
  whatsappTemplates Json @default("{}") /// Tenant-level WhatsApp template overrides keyed by message purpose

  /// Razorpay key id for this gym's own account. Null means online payments
  /// fall back to the platform account configured in the Worker environment.
  razorpayKeyId        String?
  /// Key secret, sealed with AES-GCM by `lib/secret-box`. Never leaves the API.
  razorpayKeySecret    String?
  /// Webhook signing secret, sealed the same way.
  razorpayWebhookSecret String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model TenantCharge {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String /// e.g. "Admission Fee", "Security Deposit"
  amount      Int /// Amount in smallest currency unit (paise/cents)
  isMandatory Boolean  @default(true) /// Must be paid when adding a new member
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  payments Payment[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

/// Junction table linking users to tenants with a tenant-scoped role.
/// A user can belong to only one gym.
model TenantMembership {
  id                String                  @id @default(cuid())
  tenantId          String
  tenant            Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId            String                  @unique
  user              User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  memberId          Int /// Sequential member number, unique per tenant (starts at 1)
  role              String                  @default("MEMBER")
  status            String                  @default("ACTIVE")
  dueDate           DateTime? /// Latest subscription validUntil - auto-updated on payment changes
  shiftId           String?
  shift             Shift?                  @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  referredByMembershipId String?
  referredBy        TenantMembership?       @relation("MemberReferrals", fields: [referredByMembershipId], references: [id], onDelete: SetNull)
  joinedAt          DateTime                @default(now())
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  badges            Badge[]
  referrals         TenantMembership[]      @relation("MemberReferrals")
  payments          Payment[]               @relation("PaymentUser")
  collectedPayments Payment[]               @relation("PaymentCollector")
  createdPlans      WorkoutPlan[]           @relation("PlanCreator")
  planAssignments   WorkoutPlanAssignment[] @relation("PlanAssignment")
  attendances       Attendance[]
  markedAttendances Attendance[]            @relation("AttendanceMarkedBy")
  createdTodos      Todo[]                  @relation("TodoCreatedBy")
  updatedTodos      Todo[]                  @relation("TodoUpdatedBy")
  completedTodos    Todo[]                  @relation("TodoCompletedBy")

  @@unique([tenantId, userId])
  @@unique([tenantId, memberId])
  @@index([tenantId])
  @@index([userId])
  @@index([shiftId])
  @@index([referredByMembershipId])
}

// Subscription and payment

model Subscription {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  amount       Int /// Amount in smallest currency unit (e.g. paise/cents)
  durationDays Int      @default(30)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  payments Payment[]
  badges   Badge[]

  @@index([tenantId])
}

model Shift {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  startTime   String /// 24-hour local time, e.g. "06:00"
  endTime     String /// 24-hour local time, e.g. "10:00"
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  members     TenantMembership[]

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
}

model Todo {
  id            String            @id @default(cuid())
  tenantId      String
  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  visibility    String            @default("PUBLIC")
  isCompleted   Boolean           @default(false)
  completedAt   DateTime?
  createdById   String?
  createdBy     TenantMembership? @relation("TodoCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById   String?
  updatedBy     TenantMembership? @relation("TodoUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  completedById String?
  completedBy   TenantMembership? @relation("TodoCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([tenantId, updatedAt])
  @@index([tenantId, visibility, isCompleted])
  @@index([createdById])
  @@index([updatedById])
  @@index([completedById])
}

model Payment {
  id             String            @id @default(cuid())
  amount         Int
  status         String            @default("PENDING")
  tenantId       String
  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membershipId   String
  member         TenantMembership  @relation("PaymentUser", fields: [membershipId], references: [id])
  collectorId    String?
  collectedBy    TenantMembership? @relation("PaymentCollector", fields: [collectorId], references: [id])
  subscriptionId String?
  subscription   Subscription?     @relation(fields: [subscriptionId], references: [id])
  chargeId       String?
  charge         TenantCharge?     @relation(fields: [chargeId], references: [id])
  description    String? /// Label for charge payments, e.g. "Admission Fee"
  note           String?
  paidAt         DateTime?
  validFrom      DateTime?
  validUntil     DateTime?

  /// "RAZORPAY" for online payments; null for cash and other manual entries.
  gateway          String?
  /// Gateway order id. Unique so a replayed verify cannot settle twice.
  gatewayOrderId   String?  @unique
  /// Gateway payment id, set once the charge is authorized or captured.
  gatewayPaymentId String?
  /// Whether this gym's own gateway account collected it, or the platform's.
  gatewayAccount   String?

  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([tenantId])
  @@index([membershipId])
  @@index([status])
  @@index([createdAt])
  @@index([gatewayOrderId])
}

// Commerce

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  markdown    String? /// Optional markdown rich description for the product
  photos      Json     @default("[]")
  category    String
  price       Int
  stock       Int      @default(0)
  minOrderQty Int      @default(1)
  maxOrderQty Int      @default(100)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems OrderItem[]
  reviews    ProductReview[]

  @@index([isActive])
  @@index([category])
}

model ProductReview {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId        String? /// NULL for anonymous reviews
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  rating        Int /// 1-5 star rating
  title         String
  description   String
  isAnonymous   Boolean  @default(false)
  verifiedBuyer Boolean  @default(false) /// true if user purchased this product
  helpfulCount  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  comments ProductReviewComment[]
  helpful  ProductReviewHelpful[]

  @@unique([productId, userId, createdAt]) /// Prevent multiple reviews per user per day (can adjust if needed)
  @@index([productId])
  @@index([userId])
  @@index([rating])
  @@index([createdAt])
}

model ProductReviewComment {
  id          String        @id @default(cuid())
  reviewId    String
  review      ProductReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId      String? /// NULL for anonymous comments
  user        User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  text        String
  isAnonymous Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([reviewId])
  @@index([userId])
  @@index([createdAt])
}

model ProductReviewHelpful {
  id        String        @id @default(cuid())
  reviewId  String
  review    ProductReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId    String /// Only logged-in users can mark helpful
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@unique([reviewId, userId])
  @@index([reviewId])
  @@index([userId])
}

model Order {
  id             String   @id @default(cuid())
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  buyerName      String
  buyerEmail     String
  buyerPhone     String
  buyerAddress   String
  status         String   @default("PENDING")
  subtotalAmount Int      @default(0)
  gstRatePct     Int      @default(18)
  gstAmount      Int      @default(0)
  totalAmount    Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  items OrderItem[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  productName String
  quantity    Int
  unitPrice   Int
  lineTotal   Int
  createdAt   DateTime @default(now())

  @@unique([orderId, productId])
  @@index([orderId])
  @@index([productId])
}

// Workout plans

model WorkoutPlan {
  id          String           @id @default(cuid())
  tenantId    String
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creatorId   String
  creator     TenantMembership @relation("PlanCreator", fields: [creatorId], references: [id])
  title       String
  description String?
  exercises   Json             @default("[]")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  assignments WorkoutPlanAssignment[]

  @@index([tenantId])
  @@index([creatorId])
}

model WorkoutPlanAssignment {
  id           String           @id @default(cuid())
  planId       String
  plan         WorkoutPlan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  membershipId String
  membership   TenantMembership @relation("PlanAssignment", fields: [membershipId], references: [id])
  assignedAt   DateTime         @default(now())

  @@unique([planId, membershipId])
  @@index([membershipId])
}

// Badges

model Badge {
  id          String             @id @default(cuid())
  tenantId    String
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  color       String             @default("#6366f1") /// Hex color for badge display
  icon        String? /// Optional icon identifier (e.g. "trophy", "star", "flame")
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  users       TenantMembership[]
  subscriptions Subscription[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

// Platform billing

model PlatformPayment {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  amount         Int /// Amount in smallest currency unit (paise/cents)
  note           String?
  extendsUntil   DateTime /// The new expiry date set by this payment
  recordedBy     String
  recordedByUser User     @relation(fields: [recordedBy], references: [id])
  createdAt      DateTime @default(now())

  @@index([tenantId])
}

// Attendance and audit log

model Attendance {
  id           String            @id @default(cuid())
  tenantId     String
  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membershipId String
  member       TenantMembership  @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  markedById   String? /// NULL = self check-in, otherwise the admin/coach who marked
  markedBy     TenantMembership? @relation("AttendanceMarkedBy", fields: [markedById], references: [id])
  date         DateTime /// The calendar day (no time component)
  checkInAt    DateTime          @default(now())
  note         String?
  createdAt    DateTime          @default(now())

  @@unique([tenantId, membershipId, date])
  @@index([tenantId])
  @@index([membershipId])
  @@index([date])
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String /// e.g. "User", "Tenant", "Payment"
  entityId  String?
  actorId   String?
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  metadata  Json? /// Additional context (old values, new values, etc.)
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([actorId])
  @@index([entity, entityId])
  @@index([createdAt])
}

// Push subscriptions

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

