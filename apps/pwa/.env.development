# Local development. Loaded by `npm run dev` (vite --mode development).
#
# VITE_API_URL is deliberately unset: the axios client then falls back to the
# relative "/api" base and Vite proxies it to the API below. That keeps the
# browser same-origin locally, so no CORS configuration is involved.
VITE_API_PROXY_TARGET=http://localhost:8787

# Root domains this build is served from. A host that is not one of these — and
# is not <slug>.<one of these> — is treated as the app root, not a gym subdomain.
# `localhost` covers both http://localhost:5173 and http://rudra.localhost:5173.
VITE_APP_ROOT_DOMAINS=localhost

# Must match VAPID_PUBLIC_KEY in apps/api/wrangler.toml for push to register.
VITE_VAPID_PUBLIC_KEY=BGM8SxeUeDufKP-etZ5Q-GJpW9GTmBhay_fGHK2vBlsIWVfbsbHzPD_TLVbSl35oBOnjL2qdG47YibTHhwASP2c
