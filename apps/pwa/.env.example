# Documentation: Front-end environment template.
# - Copy to `.env.local` only when you need to override the committed
#   `.env.development` values on your machine.
# - Every VITE_* value is inlined into the client bundle and is therefore public.
#   Never put a secret here.
VITE_API_PROXY_TARGET=http://localhost:8787
VITE_APP_ROOT_DOMAINS=localhost
VITE_VAPID_PUBLIC_KEY=
